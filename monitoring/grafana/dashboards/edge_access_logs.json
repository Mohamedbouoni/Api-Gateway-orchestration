{
  "annotations": { "list": [] },
  "description": "Last 24 hours of Kong access logs (Postgres + Loki) and WAF ModSecurity audit entries (Loki). Use the status filters and time picker to narrow results.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Explore Kong logs",
      "type": "link",
      "url": "/explore?orgId=1&left={\"datasource\":\"loki_ds_id\",\"queries\":[{\"refId\":\"A\",\"expr\":\"{job=\\\"kong-access\\\"} | json\",\"queryType\":\"range\"}],\"range\":{\"from\":\"now-24h\",\"to\":\"now\"}}",
      "targetBlank": true,
      "icon": "external link"
    },
    {
      "title": "Explore WAF audit",
      "type": "link",
      "url": "/explore?orgId=1&left={\"datasource\":\"loki_ds_id\",\"queries\":[{\"refId\":\"A\",\"expr\":\"{job=\\\"waf-modsec\\\"} | json\",\"queryType\":\"range\"}],\"range\":{\"from\":\"now-24h\",\"to\":\"now\"}}",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Kong requests",
      "description": "All requests recorded in Postgres by kong-logger for the selected time range.",
      "datasource": { "type": "postgres", "uid": "platform_db_ds_id" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*)::bigint AS value FROM api_usage_records WHERE $__timeFilter(request_time)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Kong 4xx+5xx",
      "datasource": { "type": "postgres", "uid": "platform_db_ds_id" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*)::bigint AS value FROM api_usage_records WHERE status >= 400 AND $__timeFilter(request_time)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 25 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Kong error rate",
      "datasource": { "type": "postgres", "uid": "platform_db_ds_id" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (100.0 * SUM(CASE WHEN status >= 400 THEN 1 ELSE 0 END) / NULLIF(COUNT(*),0))::numeric(10,2) AS value FROM api_usage_records WHERE $__timeFilter(request_time)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "WAF audit entries",
      "description": "ModSecurity audit events shipped to Loki (RelevantOnly — mostly blocks and anomalies).",
      "datasource": { "type": "loki", "uid": "loki_ds_id" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"waf-modsec\"}[$__interval]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "purple" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "WAF blocks (403)",
      "datasource": { "type": "loki", "uid": "loki_ds_id" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"waf-modsec\", status=\"403\"}[$__interval]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Kong lines in Loki",
      "description": "Live JSONL tail since kong-logger pod start (subset of Postgres history).",
      "datasource": { "type": "loki", "uid": "loki_ds_id" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"kong-access\"}[$__interval]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "semi-dark-blue" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "timeseries",
      "title": "Kong request rate (Postgres)",
      "datasource": { "type": "postgres", "uid": "platform_db_ds_id" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 4 },
      "id": 7,
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(request_time, '5m'), 'requests' AS metric, COUNT(*)::bigint AS value FROM api_usage_records WHERE $__timeFilter(request_time) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "spanNulls": true },
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "WAF audit rate (Loki)",
      "datasource": { "type": "loki", "uid": "loki_ds_id" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 4 },
      "id": 8,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"waf-modsec\"}[5m]))",
          "legendFormat": "audit events / 5m",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "stacking": { "mode": "none" } },
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "purple" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "barchart",
      "title": "Kong status distribution",
      "datasource": { "type": "postgres", "uid": "platform_db_ds_id" },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 10 },
      "id": 9,
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN status BETWEEN 200 AND 299 THEN '2xx' WHEN status BETWEEN 300 AND 399 THEN '3xx' WHEN status BETWEEN 400 AND 499 THEN '4xx' WHEN status BETWEEN 500 AND 599 THEN '5xx' ELSE 'other' END AS bucket, COUNT(*)::bigint AS count FROM api_usage_records WHERE $__timeFilter(request_time) AND ( '${status_class}' = 'All' OR ('${status_class}' = '2xx' AND status BETWEEN 200 AND 299) OR ('${status_class}' = '4xx' AND status BETWEEN 400 AND 499) OR ('${status_class}' = '5xx' AND status >= 500) OR ('${status_class}' = 'errors' AND status >= 400) ) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "legend": { "displayMode": "hidden", "placement": "bottom" }
      }
    },
    {
      "type": "text",
      "title": "",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 15 },
      "id": 10,
      "options": {
        "mode": "markdown",
        "content": "## Kong Gateway — access log list\n**Postgres** (`api_usage_records`) holds the full history for the selected range (default **last 24h**). Up to **500** rows, newest first. Use **Status class** above to filter."
      },
      "transparent": true
    },
    {
      "type": "table",
      "title": "Kong access log (last 500 requests)",
      "description": "Structured access records from kong-logger. Columns match AWS API Gateway access log fields.",
      "datasource": { "type": "postgres", "uid": "platform_db_ds_id" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 17 },
      "id": 11,
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT request_time AS \"Time\", http_method AS \"Method\", path AS \"Path\", status AS \"Status\", response_latency_ms AS \"Latency (ms)\", source_ip::text AS \"Client IP\", COALESCE(consumer_username, consumer_id, '<anon>') AS \"Consumer\", request_id AS \"Request ID\" FROM api_usage_records WHERE $__timeFilter(request_time) AND ( '${status_class}' = 'All' OR ('${status_class}' = '2xx' AND status BETWEEN 200 AND 299) OR ('${status_class}' = '4xx' AND status BETWEEN 400 AND 499) OR ('${status_class}' = '5xx' AND status >= 500) OR ('${status_class}' = 'errors' AND status >= 400) ) AND ( '${path_search}' = '' OR path ILIKE '%' || '${path_search}' || '%' ) ORDER BY request_time DESC LIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "green", "value": 200 },
                    { "color": "yellow", "value": 300 },
                    { "color": "orange", "value": 400 },
                    { "color": "red", "value": 500 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Latency (ms)" },
            "properties": [
              { "id": "unit", "value": "ms" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 500 },
                    { "color": "red", "value": 2000 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text", "mode": "gradient" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.width", "value": 180 }]
          },
          {
            "matcher": { "id": "byName", "options": "Path" },
            "properties": [{ "id": "custom.width", "value": 320 }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false }
      }
    },
    {
      "type": "logs",
      "title": "Kong raw access lines (Loki, live tail)",
      "description": "JSONL lines from the kong-logger pod (since last restart). Useful for debugging; use the table above for full 24h history.",
      "datasource": { "type": "loki", "uid": "loki_ds_id" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 31 },
      "id": 12,
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"kong-access\"} | json",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "type": "text",
      "title": "",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 41 },
      "id": 13,
      "options": {
        "mode": "markdown",
        "content": "## WAF — ModSecurity audit log\n**Loki** (`job=waf-modsec`). Audit engine is **RelevantOnly** (blocks and anomalies, not every request). Entries are shown as **compact one-line summaries** (method, path, status, client IP, rule id)."
      },
      "transparent": true
    },
    {
      "type": "logs",
      "title": "WAF audit log (last 300 entries)",
      "description": "Compact one-line summaries from ModSecurity audit (method, path, status, client IP).",
      "datasource": { "type": "loki", "uid": "loki_ds_id" },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 43 },
      "id": 14,
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki_ds_id" },
          "expr": "{job=\"waf-modsec\", status=~\"$waf_status\"}",
          "queryType": "range",
          "editorMode": "code",
          "maxLines": 300,
          "legendFormat": "",
          "direction": "backward"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["edge", "kong", "waf", "loki", "access-logs", "postgres"],
  "templating": {
    "list": [
      {
        "name": "status_class",
        "label": "Kong status class",
        "type": "custom",
        "query": "All,2xx,4xx,5xx,errors",
        "current": { "text": "All", "value": "All", "selected": true },
        "options": [
          { "text": "All", "value": "All", "selected": true },
          { "text": "2xx", "value": "2xx", "selected": false },
          { "text": "4xx", "value": "4xx", "selected": false },
          { "text": "5xx", "value": "5xx", "selected": false },
          { "text": "errors (4xx+5xx)", "value": "errors", "selected": false }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "path_search",
        "label": "Kong path contains",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" },
        "hide": 0
      },
      {
        "name": "waf_status",
        "label": "WAF filter",
        "type": "custom",
        "query": ".*,403",
        "current": { "text": "All audit events", "value": ".*", "selected": true },
        "options": [
          { "text": "All audit events", "value": ".*", "selected": true },
          { "text": "Blocks (403) only", "value": "403", "selected": false }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d"]
  },
  "timezone": "",
  "title": "Edge Access Logs (Kong + WAF)",
  "uid": "edge-access-logs",
  "version": 4,
  "weekStart": ""
}
